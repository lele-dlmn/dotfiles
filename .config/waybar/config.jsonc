// -*- mode: jsonc -*-
{
    // monitor: 2240x1400 
    "height": 28,
    "width": 1600,
    
    "spacing": 4, // Gaps between modules (4px)
    
    "position": "top",
    "fixed-centre": true,

    // Choose the order of the modules
    "modules-left": [
	"clock"
    //    "sway/window"
    ],
    
    "modules-center": [
        "sway/workspaces"
    ],
    
    "modules-right": [
        "network",
        "battery",
        "battery#bat2"
    //  "clock"
    ],



    // Modules configuration
    "sway/window": {
       "format": "{title}",
       "max-length": 50
    },

    "sway/workspaces": {
    	"active-only": false,
	"all-outputs": true,
    	"format": "{icon}",

    	"format-icons": {
	   "default": "󰜌",
	   "focused": "󰨑",
	   "urgent": "󱇎"
	}
    },
      

    "clock": {
        // "timezone": "America/New_York",
	"format": "{:%m/%d, %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%a, %b %d}",
	"margin-left": 12
    },


    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-alt": "{time}",
	"margin-right": 12
    },
    "battery#bat2": {
        "bat": "BAT2"
    },


    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid}",
        "format-ethernet": "{ifname}",

        "tooltip-format": "{ipaddr}",
        "format-disconnected": "N/A",

        "format-alt": "{ipaddr}",
	"on-click-right": "kitty --class nmtui nmtui"
    }
}
